# Preview installs separately from the live apps.
APP_VARIANT=preview

# Paste the deployed Google Apps Script /exec URL from apps-script/Code.gs.
EXPO_PUBLIC_CONFIG_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Production identity is locked in app.config.js:
# iOS org.tiffinstash.app · Android com.tiffinstash · App Store 6505018028
# Set the values below only after checking both existing developer consoles.
# IOS_BUILD_NUMBER=copy-a-new-unused-build-number
# ANDROID_VERSION_CODE=integer-greater-than-every-existing-track-build
# EAS_PROJECT_ID=your-company-owned-expo-project-uuid
# RELEASE_IDENTITY_VERIFIED=YES
# APP_VERSION=5.0.0
